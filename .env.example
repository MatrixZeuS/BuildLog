# GEMINI_API_KEY: Required for server-side Gemini activity summarization.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# GITHUB_APP_ID: Numeric GitHub App ID for server-side JWT authentication.
GITHUB_APP_ID=""

# GITHUB_APP_SLUG: Public slug of your GitHub App (used for installation URL).
GITHUB_APP_SLUG=""

# GITHUB_APP_CLIENT_ID: GitHub App Client ID for user authorization verification.
GITHUB_APP_CLIENT_ID=""

# GITHUB_APP_CLIENT_SECRET: GitHub App Client Secret for server-side OAuth token exchange.
GITHUB_APP_CLIENT_SECRET=""

# GITHUB_APP_PRIVATE_KEY: PEM private key for the GitHub App (newlines escaped as \n).
GITHUB_APP_PRIVATE_KEY=""

# GITHUB_WEBHOOK_SECRET: Secret configured on the GitHub App webhook for HMAC-SHA256 verification.
GITHUB_WEBHOOK_SECRET=""

# FIREBASE_SERVICE_ACCOUNT: Full contents of a Firebase service account key .json (raw JSON or base64).
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# Required on Vercel: the server stores sign-in sessions and the GitHub update queue in Firestore.
# Not needed for local development (data is kept in .data/server-state.json).
FIREBASE_SERVICE_ACCOUNT=""

# BUILDLOG_STORAGE: Set to "firestore" to use Firestore storage outside Vercel (optional).
# BUILDLOG_STORAGE=""
